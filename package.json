{
  "name": "drawdraw",
  "version": "1.0.0",
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "test": "jest",
    "test:conventions": "node --test test/conventions.mjs",
    "check": "npm run lint && npm test && npm run test:conventions",
    "icons": "node tools/make-icons.mjs",
    "icons:check": "node tools/make-icons.mjs --check",
    "build:web": "expo export --platform web --output-dir .web-build",
    "test:e2e": "npm run build:web && node e2e/smoke.mjs",
    "test:all": "npm test && npm run test:e2e",
    "e2e": "npm run test:e2e"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "expo": "~53.0.9",
    "expo-file-system": "~18.1.11",
    "expo-haptics": "~14.1.4",
    "expo-image-picker": "~16.1.4",
    "expo-media-library": "~17.1.6",
    "expo-sharing": "~13.1.5",
    "expo-splash-screen": "^0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.11",
    "react": "19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "0.79.6",
    "react-native-svg": "^15.11.2",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~9.2.0",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.0",
    "playwright": "^1.55.1"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  }
}
