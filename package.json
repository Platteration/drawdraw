{
  "name": "drawdraw",
  "version": "1.0.0",
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:conventions": "node --test test/conventions.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:conventions",
    "icons": "node tools/make-icons.mjs",
    "icons:check": "node tools/make-icons.mjs --check",
    "build:web": "expo export --platform web --output-dir .web-build",
    "test:e2e": "npm run build:web && node e2e/smoke.mjs",
    "test:all": "npm test && npm run test:e2e",
    "e2e": "npm run test:e2e"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.20",
    "expo-constants": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.19",
    "expo-media-library": "~57.0.5",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.4",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "playwright": "^1.55.1",
    "typescript": "~6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  }
}
