{
  "expo": {
    "name": "DrawDraw",
    "slug": "drawdraw",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#f4efe6",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.platteration.drawdraw"
    },
    "android": {
      "package": "com.platteration.drawdraw",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f4efe6"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "DrawDraw needs access to your photos so you can pick a portrait to overlay drawing guides on.",
          "cameraPermission": "DrawDraw needs camera access so you can take a portrait photo to overlay drawing guides on."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "DrawDraw saves your exported guide overlays and tracing layers to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f4efe6"
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    }
  }
}
